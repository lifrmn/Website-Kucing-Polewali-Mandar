# Salin file ini menjadi .env, isi nilainya, lalu jalankan `npm run env:encrypt`.
# Jangan commit .env.keys atau membagikan DOTENV_PRIVATE_KEY.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"
# Production: use the public HTTPS origin, for example https://cikalpetcare.com
AUTH_URL="http://localhost:3000"
# Canonical public website origin used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-password-at-least-12-characters"
SEED_RESET_DATABASE="false"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

RESEND_API_KEY=""
EMAIL_FROM="Cikal Pet Care Polman <no-reply@example.com>"
# Optional recipient for new booking notifications
EMAIL_ADMIN_TO=""

# Optional automatic customer WhatsApp notifications: FONNTE or WABLAS.
WHATSAPP_PROVIDER=""
WHATSAPP_API_TOKEN=""
# Fonnte can leave this empty. Wablas requires the endpoint assigned to your device.
WHATSAPP_API_URL=""

# SQLite backup (production: point this to persistent/off-host storage)
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"