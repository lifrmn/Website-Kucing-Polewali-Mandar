{
  "name": "cikal-pet-care-polman",
  "version": "1.0.0",
  "description": "Website Profesional untuk Cikal Pet Care Polman - Konsultan Kesehatan Kucing",
  "author": "Cikal Pet Care Polman",
  "license": "MIT",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "dotenvx run -- next dev",
    "build": "dotenvx run -- prisma generate && dotenvx run -- next build",
    "start": "dotenvx run -- node scripts/start-production.js",
    "lint": "eslint app src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "db:seed": "dotenvx run -- tsx prisma/seed.ts",
    "db:migrate": "dotenvx run -- prisma migrate deploy",
    "db:backup": "dotenvx run -- node scripts/backup-database.js",
    "env:encrypt": "dotenvx encrypt -f .env",
    "env:decrypt": "dotenvx decrypt -f .env"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.3.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.574.0",
    "multer": "^2.3.0",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.8.1",
    "resend": "^6.26.0",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "@hookform/resolvers": "^5.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
